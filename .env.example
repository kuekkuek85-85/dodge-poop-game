# Vercel 프로젝트 환경변수 (Production / Preview 모두 설정)

# --- Firebase Admin (필수) ---
# 방법 A: 서비스 계정 JSON 전체를 한 줄로 붙여넣기 (권장)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# 방법 B: 개별 지정 (A를 쓰면 불필요)
# FIREBASE_PROJECT_ID=dodge-poop-xxxx
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@dodge-poop-xxxx.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- 교사 모드 ---
TEACHER_CODE=123456

# --- 서명 비밀키 (16자 이상, 설정을 권장) ---
# 비워 두면 Firebase 서비스 계정 자격 증명에서 파생한다.
# 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=긴_랜덤_문자열
# RUN_SECRET=또_다른_긴_랜덤_문자열

# --- 로컬 개발 전용: Firestore 없이 메모리 저장소 사용 ---
# DEV_MEMORY_STORE=1
